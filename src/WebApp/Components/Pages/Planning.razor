@page "/planning"
@using WebApp.Services;
@inject PlanningApiService Http
@using System.ComponentModel.DataAnnotations
@using System.Linq

<PageTitle>Planning</PageTitle>
<TabLayout/>

<h3>Список товаров</h3>

@if (isLoading)
{
    <p>Загрузка данных...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">Ошибка: @errorMessage</p>
}
else if (apiResponse != null)
{
    <div class="mb-3">
        <input @bind="searchTerm" @bind:event="oninput" class="form-control" placeholder="Поиск по описанию или ID..." />
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Описание</th>
                <th>Ед. изм.</th> <!-- или "Хост-артикул", если UnitOfMeasure не подходит -->
            </tr>
        </thead>
        <tbody>
            @foreach (var product in FilteredData)
            {
                <tr>
                    <td>@product.Item</td>
                    <td>@product.Description</td> <!-- ← Исправлено -->
                    <td>@product.UnitOfMeasure</td> <!-- ← Исправлено -->
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination mt-3">
        <button @onclick="PrevPage" disabled="@(apiResponse.PageIndex == 0)" class="btn btn-secondary">Назад</button>
        <span class="mx-2">Страница @(apiResponse.PageIndex + 1)</span>
        <button @onclick="NextPage" disabled="@(apiResponse.PageIndex >= apiResponse.TotalPages - 1)" class="btn btn-secondary">Вперед</button>
    </div>
}

@code {
    private ApiResponse? apiResponse;
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 0;
    private const int PageSize = 10;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData(currentPage);
    }

    private async Task LoadData(int page)
    {
        try
        {
            isLoading = true;
            var response = await Http.GetResponse(page, PageSize);

            if (response != null)
            {
                apiResponse = response;
                apiResponse.TotalPages = PageSize > 0 
                    ? (int)Math.Ceiling(response.Count / (double)PageSize) 
                    : 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task NextPage()
    {
        if (apiResponse != null && apiResponse.PageIndex < apiResponse.TotalPages - 1)
        {
            currentPage++;
            await LoadData(currentPage);
        }
    }

    private async Task PrevPage()
    {
        if (apiResponse != null && apiResponse.PageIndex > 0)
        {
            currentPage--;
            await LoadData(currentPage);
        }
    }

    private List<Product> FilteredData => string.IsNullOrWhiteSpace(searchTerm)
        ? apiResponse?.Data ?? new()
        : apiResponse?.Data?.Where(p =>
            p.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true || // ← Исправлено
            p.Item.ToString().Contains(searchTerm)
        ).ToList() ?? new();

    public class ApiResponse
    {
        public int PageIndex { get; set; }
        public int PageSize { get; set; }
        public int Count { get; set; }
        public int TotalPages { get; set; }
        public List<Product> Data { get; set; } = new();
    }
     /**/
    public class Product
    {
        public int Item { get; set; }
        public string Description { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = string.Empty;
    }
}